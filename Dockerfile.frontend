FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source files including public/
COPY . .

# Expose Vite dev server port
EXPOSE 5174

# Start the Vite dev server (proxies /api -> backend:8000)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5174"]
