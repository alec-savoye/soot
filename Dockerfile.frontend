FROM node:20-alpine

WORKDIR /app/frontend

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Build the application
RUN npm run build

# Expose port
EXPOSE 3000

# Start the application with proper environment
ENV HOST=0.0.0.0
ENV PORT=3000
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0"]
